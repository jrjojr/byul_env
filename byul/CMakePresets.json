{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-debug",
            "displayName": "Ubuntu Debug Build",
            "description": "로컬 Ubuntu에서 디버그용 빌드",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/../build_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Ubuntu Release Build",
            "description": "로컬 Ubuntu에서 릴리즈용 빌드",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/../build_release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-release-package",
            "inherits": "linux-release",
            "displayName": "Ubuntu Release Package (tests off)",
            "description": "Ubuntu production package without test targets",
            "binaryDir": "${sourceDir}/../build_release_package",
            "cacheVariables": {
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "win-release",
            "displayName": "Windows 11 (MinGW64 Cross)",
            "description": "Windows DLL 빌드용 크로스 컴파일 Preset",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/../build_win_release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-mingw64.cmake"
            }
        },
        {
            "name": "win-release-package",
            "inherits": "win-release",
            "displayName": "Windows MinGW Release Package (tests off)",
            "description": "Windows cross production package without test targets",
            "binaryDir": "${sourceDir}/../build_win_release_package",
            "cacheVariables": {
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "win_sdl_release",
            "displayName": "Windows 11 (MinGW64 Cross) - SDL 실행파일",
            "description": "SDL 실행파일 (EXE)용 Windows 크로스 컴파일 Preset",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/../build_win_sdl_release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-mingw64.cmake"
            }
        },
        {
            "name": "win-native",
            "displayName": "Windows 11 (MSYS2 MinGW Native)",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/../build_win_native",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "win-native-package",
            "inherits": "win-native",
            "displayName": "Windows Native Release Package (tests off)",
            "description": "Windows native production package without test targets",
            "binaryDir": "${sourceDir}/../build_win_native_package",
            "cacheVariables": {
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "win-native-debug",
            "displayName": "Windows 11 (MSYS2 MinGW Native - Debug)",
            "description": "Windows 11에서 MinGW Native Debug 빌드",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/../build_win_native_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win-msvc",
            "displayName": "Windows 11 (MSVC)",
            "description": "Visual Studio 2022 (x64) 다중 구성 빌드",
            "generator": "Visual Studio 17 2022",
            "cmakeExecutable": "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe",
            "binaryDir": "${sourceDir}/../build_win_msvc",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
            }
        },
        {
            "name": "win-msvc-package",
            "inherits": "win-msvc",
            "displayName": "Windows MSVC Release Package (tests off)",
            "description": "MSVC production package without test targets",
            "binaryDir": "${sourceDir}/../build_win_msvc_package",
            "cacheVariables": {
                "BUILD_TESTING": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-linux-debug",
            "configurePreset": "linux-debug",
            "description": "로컬 Ubuntu Debug 전체 빌드",
            "jobs": 8
        },
        {
            "name": "build-linux-release",
            "configurePreset": "linux-release",
            "description": "로컬 Ubuntu Release 전체 빌드",
            "jobs": 8
        },
        {
            "name": "build-linux-release-package",
            "configurePreset": "linux-release-package",
            "description": "Ubuntu tests-off production package build",
            "jobs": 8
        },
        {
            "name": "build-win-release",
            "configurePreset": "win-release",
            "description": "Windows용 전체 빌드 preset",
            "jobs": 8
        },
        {
            "name": "build-win-release-package",
            "configurePreset": "win-release-package",
            "description": "Windows MinGW tests-off production package build",
            "jobs": 8
        },
        {
            "name": "build-win_sdl_release",
            "configurePreset": "win_sdl_release",
            "description": "Windows SDL 전체 빌드 (MinGW64)",
            "jobs": 8
        },
        {
            "name": "build-win-native",
            "configurePreset": "win-native",
            "description": "Windows native 전체 빌드 preset",
            "jobs": 8
        },
        {
            "name": "build-win-native-package",
            "configurePreset": "win-native-package",
            "description": "Windows native tests-off production package build",
            "jobs": 8
        },
        {
            "name": "build-win-native-debug",
            "configurePreset": "win-native-debug",
            "description": "Windows native Debug 전체 빌드 preset",
            "jobs": 8
        },
        {
            "name": "build-win-msvc-release",
            "configurePreset": "win-msvc",
            "description": "Windows MSVC Release 전체 빌드",
            "configuration": "Release",
            "jobs": 8
        },
        {
            "name": "build-win-msvc-debug",
            "configurePreset": "win-msvc",
            "description": "Windows MSVC Debug 전체 빌드",
            "configuration": "Debug",
            "jobs": 8
        },
        {
            "name": "build-win-msvc-package",
            "configurePreset": "win-msvc-package",
            "description": "Windows MSVC tests-off production package build",
            "configuration": "Release",
            "jobs": 8
        }
    ],
    "testPresets": [
        {
            "name": "test-win-msvc-release",
            "configurePreset": "win-msvc",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-win-msvc-debug",
            "configurePreset": "win-msvc",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-win-msvc-release-memory",
            "configurePreset": "win-msvc",
            "configuration": "Release",
            "filter": {
                "include": {
                    "name": "^test_navsys_allocation_(failure|leak_gate)$"
                }
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-linux-debug-memory",
            "configurePreset": "linux-debug",
            "filter": {
                "include": {
                    "name": "^test_navsys_allocation_(failure|leak_gate)$"
                }
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
