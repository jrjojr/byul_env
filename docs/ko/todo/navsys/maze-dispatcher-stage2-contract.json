{
  "schema_version": 1,
  "stage": 2,
  "title": "maze dispatcher common generation and capability contract",
  "status": "complete",
  "coordinate_contract": {
    "origin_type": "int32_t",
    "extent_type": "uint32_t",
    "cell_bounds": "[origin, origin + extent)",
    "overflow_rule": "origin plus extent must be representable as an int32 half-open bound",
    "output_coordinate_space": "world cell coordinates"
  },
  "options_contract": {
    "proposed_type": "byul_maze_generate_options_t",
    "abi_version": 1,
    "required_fields": [
      "uint32_t struct_size",
      "uint32_t abi_version",
      "uint64_t seed",
      "uint64_t max_steps",
      "uint64_t max_cells",
      "byul_maze_generate_cancel_func cancel_func",
      "void* cancel_userdata"
    ],
    "options_pointer": "required for the canonical deterministic API",
    "unknown_version_or_flags": "NAVSYS_STATUS_UNSUPPORTED",
    "short_struct": "NAVSYS_STATUS_INVALID_ARGUMENT",
    "max_steps_zero": "use the versioned per-algorithm default_step_multiplier",
    "max_cells_zero": "use the versioned library safety ceiling",
    "output_on_failure": "out_maze is NULL",
    "output_on_success": "caller-owned maze_t destroyed by maze_destroy"
  },
  "rng_contract": {
    "algorithm": "pcg32-xsh-rr-v1",
    "seed_bits": 64,
    "arithmetic": "unsigned modulo 2^64 for state and modulo 2^32 for output",
    "multiplier": "6364136223846793005",
    "stream": "fixed BYUL Maze stream sequence 0x4d415a455f5631",
    "initialization": [
      "state = 0",
      "increment = (sequence << 1) | 1 using uint64 modulo arithmetic",
      "discard one pcg32 output",
      "state = state + seed using uint64 modulo arithmetic",
      "discard one pcg32 output"
    ],
    "next_u32": [
      "oldstate = state",
      "state = oldstate * 6364136223846793005 + increment using uint64 modulo arithmetic",
      "xorshifted = uint32(((oldstate >> 18) ^ oldstate) >> 27)",
      "rot = uint32(oldstate >> 59)",
      "return rotate_right_32(xorshifted, rot)"
    ],
    "bounded_sampling": "for bound > 0, threshold = uint32(-bound) % bound; draw next_u32 until value >= threshold, then return value % bound",
    "forbidden_sampling": "direct modulo reduction without rejection and standard-library random distributions",
    "replay_scope": "cross-platform and cross-toolchain for the same algorithm, behavior version, seed and options",
    "draw_order": "owned by each algorithm behavior version",
    "legacy_rng": "legacy maze_make remains a separately characterized nondeterministic adapter until Stage 3"
  },
  "termination_contract": {
    "step_definition": "one algorithm-specific state transition named by capability budget_unit",
    "limit_status": "NAVSYS_STATUS_LIMIT_REACHED",
    "cancellation_status": "NAVSYS_STATUS_CANCELLED",
    "polling": "before allocation and at least once per state transition",
    "callback_thread": "calling thread",
    "callback_retention": "not retained beyond the call",
    "callback_exception": "NAVSYS_STATUS_CALLBACK_FAILED at the C ABI boundary",
    "failure_atomicity": "no partial maze escapes on invalid, unsupported, OOM, cancelled or limit status"
  },
  "status_contract": {
    "invalid_arguments_or_overflow": "NAVSYS_STATUS_INVALID_ARGUMENT",
    "unsupported_algorithm_or_dimension": "NAVSYS_STATUS_UNSUPPORTED",
    "allocation_failure": "NAVSYS_STATUS_OUT_OF_MEMORY",
    "callback_failure": "NAVSYS_STATUS_CALLBACK_FAILED",
    "cancelled": "NAVSYS_STATUS_CANCELLED",
    "step_or_cell_limit": "NAVSYS_STATUS_LIMIT_REACHED",
    "success": "NAVSYS_STATUS_OK"
  },
